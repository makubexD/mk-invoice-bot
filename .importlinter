[importlinter]
root_package = invoicebot
# OpenCV, zxing and Playwright are graphed so the helper-only contracts can forbid them (D78, D82).
include_external_packages = True

[importlinter:contract:zero-consumer]
name = Core modules must not import consumer modules (R-12.7)
type = forbidden
source_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels
    invoicebot.rules
    invoicebot.extract
    invoicebot.routing
forbidden_modules =
    invoicebot.api
    invoicebot.events

[importlinter:contract:leaf-packages]
name = Rules and config are leaves: they import nothing else from the app
type = forbidden
source_modules =
    invoicebot.rules
    invoicebot.config
forbidden_modules =
    invoicebot.api
    invoicebot.events
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels

[importlinter:contract:store-is-low]
name = Store never imports the layers that use it
type = forbidden
source_modules =
    invoicebot.store
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue

[importlinter:contract:pure-readers]
name = Extract and routing are pure: no pipeline, queue, store or channel imports
type = forbidden
source_modules =
    invoicebot.extract
    invoicebot.routing
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels

[importlinter:contract:heavy-in-helper-only]
name = OpenCV and zxing load only in the extract helper process (D78)
type = forbidden
source_modules =
    invoicebot.api
    invoicebot.app
    invoicebot.channels
    invoicebot.config
    invoicebot.events
    invoicebot.logging
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.routing
    invoicebot.rules
    invoicebot.secrets
    invoicebot.settings
    invoicebot.store
forbidden_modules =
    cv2
    zxingcpp
    invoicebot.extract.ocr

[importlinter:contract:browser-in-helper-only]
name = Playwright loads only in the browser helper process (D82)
type = forbidden
source_modules =
    invoicebot.api
    invoicebot.app
    invoicebot.channels
    invoicebot.config
    invoicebot.events
    invoicebot.extract
    invoicebot.fetchers
    invoicebot.logging
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.routing
    invoicebot.rules
    invoicebot.secrets
    invoicebot.settings
    invoicebot.store
forbidden_modules =
    playwright
ignore_imports =
    invoicebot.fetchers.browser.** -> playwright.**
    invoicebot.fetchers.browser -> playwright.**
# The browser helper lands in a later step of plan-mvp-fetch; until then the ignores match nothing.
unmatched_ignore_imports_alerting = none
