[importlinter]
root_package = invoicebot

[importlinter:contract:zero-consumer]
name = Core modules must not import consumer modules (R-12.7)
type = forbidden
source_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels
    invoicebot.rules
forbidden_modules =
    invoicebot.api
    invoicebot.events

[importlinter:contract:leaf-packages]
name = Rules and config are leaves: they import nothing else from the app
type = forbidden
source_modules =
    invoicebot.rules
    invoicebot.config
forbidden_modules =
    invoicebot.api
    invoicebot.events
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels

[importlinter:contract:store-is-low]
name = Store never imports the layers that use it
type = forbidden
source_modules =
    invoicebot.store
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
