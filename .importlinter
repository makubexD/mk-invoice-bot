[importlinter]
root_package = invoicebot
# OpenCV, zxing and Playwright are graphed so the helper-only contracts can forbid them (D78, D82).
include_external_packages = True

[importlinter:contract:zero-consumer]
name = Core modules must not import consumer modules (R-12.7)
type = forbidden
source_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels
    invoicebot.rules
    invoicebot.extract
    invoicebot.routing
    invoicebot.net
    invoicebot.fetchers
    invoicebot.sinks
    invoicebot.auth
    invoicebot.gaps
    invoicebot.github
    invoicebot.ops
forbidden_modules =
    invoicebot.api
    invoicebot.events

[importlinter:contract:sinks-are-low]
name = Sinks and auth never import the layers that use them (file-b)
type = forbidden
source_modules =
    invoicebot.sinks
    invoicebot.auth
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store

[importlinter:contract:fetchers-are-low]
name = Fetchers never import the layers that use them
type = forbidden
source_modules =
    invoicebot.fetchers
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store

[importlinter:contract:leaf-packages]
name = Rules and config are leaves: they import nothing else from the app
type = forbidden
source_modules =
    invoicebot.rules
    invoicebot.config
    invoicebot.net
forbidden_modules =
    invoicebot.api
    invoicebot.events
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels
    invoicebot.sinks

[importlinter:contract:gaps-is-leaf]
name = Gaps imports only config and fetchers.base from the app (R-11.2, D117)
type = forbidden
source_modules =
    invoicebot.gaps
forbidden_modules =
    invoicebot.api
    invoicebot.events
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels
    invoicebot.github
    invoicebot.rules
    invoicebot.extract
    invoicebot.routing
    invoicebot.net
    invoicebot.sinks
    invoicebot.auth

[importlinter:contract:github-is-low]
name = GitHub never imports the layers that use it (D117)
type = forbidden
source_modules =
    invoicebot.github
forbidden_modules =
    invoicebot.api
    invoicebot.events
    invoicebot.pipeline
    invoicebot.queue.worker
    invoicebot.store
# The transport implements the outbox port, whose module opens the store's pool.
allow_indirect_imports = true

[importlinter:contract:store-is-low]
name = Store never imports the layers that use it
type = forbidden
source_modules =
    invoicebot.store
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue

[importlinter:contract:store-no-adapters]
name = The store imports no SUNAT adapter
type = forbidden
source_modules =
    invoicebot.store
forbidden_modules =
    invoicebot.sunat

[importlinter:contract:sunat-is-low]
name = SUNAT never imports the layers that use it (D124)
type = forbidden
source_modules =
    invoicebot.sunat
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.api
    invoicebot.events

[importlinter:contract:pipeline-is-channel-neutral]
name = The pipeline never names the WhatsApp adapter
type = forbidden
source_modules =
    invoicebot.pipeline
forbidden_modules =
    invoicebot.channels.whatsapp

[importlinter:contract:pure-readers]
name = Extract and routing are pure: no pipeline, queue, store or channel imports
type = forbidden
source_modules =
    invoicebot.extract
    invoicebot.routing
forbidden_modules =
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.store
    invoicebot.channels

[importlinter:contract:heavy-in-helper-only]
name = OpenCV and zxing load only in the extract helper process (D78)
type = forbidden
source_modules =
    invoicebot.api
    invoicebot.app
    invoicebot.channels
    invoicebot.config
    invoicebot.events
    invoicebot.logging
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.routing
    invoicebot.rules
    invoicebot.secrets
    invoicebot.settings
    invoicebot.store
forbidden_modules =
    cv2
    zxingcpp
    invoicebot.extract.ocr

[importlinter:contract:browser-in-helper-only]
name = Playwright loads only in the browser helper process (D82)
type = forbidden
source_modules =
    invoicebot.api
    invoicebot.app
    invoicebot.channels
    invoicebot.config
    invoicebot.events
    invoicebot.extract
    invoicebot.fetchers
    invoicebot.logging
    invoicebot.pipeline
    invoicebot.queue
    invoicebot.routing
    invoicebot.rules
    invoicebot.secrets
    invoicebot.settings
    invoicebot.store
forbidden_modules =
    playwright
ignore_imports =
    invoicebot.fetchers.browser.** -> playwright
    invoicebot.fetchers.browser -> playwright
# The browser helper lands in a later step of plan-mvp-fetch; until then the ignores match nothing.
unmatched_ignore_imports_alerting = none
